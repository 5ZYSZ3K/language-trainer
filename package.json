{
  "name": "language-trainer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsx scripts/check-data.ts && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check-data": "tsx scripts/check-data.ts",
    "test": "vitest run",
    "scrape:cs:verbs": "tsx scraper/cli.ts --language cs --quiz verb-present-tense",
    "scrape:cs:nouns": "tsx scraper/cli.ts --language cs --quiz noun-declension",
    "publish-pages": "tsx scripts/publish-pages.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "cheerio": "^1.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
